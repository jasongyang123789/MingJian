# Harness run outputs (defaults live outside the repo under $BACKTEST_RUN_DIR;
# these guards catch a run pointed at this dir by mistake).
# All patterns are anchored (leading /) so they match only this directory —
# unanchored raw-desay/ would also match reference/seamfix/raw-desay/.
/*.db
/*.log
/raw-desay/
/raw-classic/
/headline-check.json
/milestone-scores.json
/profit-summary.json
/acme-smoke-c1.json
/analysis-*.txt
/server-*.log
/.proxy-secret
/__pycache__/
